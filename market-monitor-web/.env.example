ANALYSIS_API_URL=http://127.0.0.1:8502

# Forecast email is disabled by default. Do not add real credentials to this file.
FORECAST_EMAIL_ENVIRONMENT=local
FORECAST_EMAIL_DISPATCH_ENABLED=false
FORECAST_EMAIL_PROVIDER_TIMEOUT_MS=10000
FORECAST_EMAIL_RESPONSE_MAX_BYTES=16384
FORECAST_EMAIL_DISPATCH_LIMIT=10
FORECAST_EMAIL_WEBHOOK_MAX_BYTES=65536

# Required only for explicitly authorized live email work. Keep these blank locally.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
FORECAST_EMAIL_CAPABILITY_SECRET=
FORECAST_EMAIL_FROM=
FORECAST_EMAIL_REPLY_TO=
PUBLIC_APP_URL=

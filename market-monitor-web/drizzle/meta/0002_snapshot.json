          "value": "\"forecasts\".\"status\" IN ('draft', 'active', 'target_hit', 'invalidated', 'expired', 'cancelled')"
        },
        "forecasts_target_check": {
          "name": "forecasts_target_check",
          "value": "(\n    (\"forecasts\".\"target_kind\" = 'price' AND \"forecasts\".\"target_price\" IS NOT NULL AND \"forecasts\".\"target_price\" > 0 AND \"forecasts\".\"target_lower\" IS NULL AND \"forecasts\".\"target_upper\" IS NULL)\n    OR\n    (\"forecasts\".\"target_kind\" = 'range' AND \"forecasts\".\"target_price\" IS NULL AND \"forecasts\".\"target_lower\" IS NOT NULL AND \"forecasts\".\"target_lower\" > 0 AND \"forecasts\".\"target_upper\" IS NOT NULL AND \"forecasts\".\"target_upper\" > \"forecasts\".\"target_lower\")\n  )"
        },
        "forecasts_invalidation_check": {
          "name": "forecasts_invalidation_check",
          "value": "\"forecasts\".\"invalidation_price\" IS NULL OR \"forecasts\".\"invalidation_price\" > 0"
        },

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-mini

# Northstar Phase 3A1 defaults to deny-all. The local launcher explicitly sets
# these development-only values; never use local_bootstrap outside local/test.
NORTHSTAR_ENVIRONMENT=local
NORTHSTAR_AUTH_MODE=local_bootstrap
NORTHSTAR_SYSTEM_PROFILE_ID=1

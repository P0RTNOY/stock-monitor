{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node --experimental-strip-types --test app/lib/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "forecast:coordinate": "node --experimental-strip-types scripts/run-forecast-coordinator.ts",
    "forecast:schedule:simulate": "node --experimental-strip-types scripts/run-forecast-scheduler.ts",
    "forecast:schedule:status": "node --experimental-strip-types scripts/run-forecast-scheduler-status.ts",
    "forecast:notifications:project": "node --experimental-strip-types scripts/run-forecast-notification-projector.ts",
    "forecast:notifications:backfill": "node --experimental-strip-types scripts/run-forecast-notification-backfill.ts",
    "forecast:notifications:status": "node --experimental-strip-types scripts/run-forecast-notification-status.ts",
    "forecast:notifications:in-app:project": "node --experimental-strip-types scripts/run-forecast-in-app-notification-projector.ts",
    "forecast:notifications:in-app:backfill": "node --experimental-strip-types scripts/run-forecast-in-app-notification-backfill.ts",
    "forecast:notifications:in-app:status": "node --experimental-strip-types scripts/run-forecast-in-app-notification-status.ts",
    "forecast:email:recipient": "node --experimental-strip-types scripts/run-forecast-email-recipient.ts",
    "forecast:email:consent": "node --experimental-strip-types scripts/run-forecast-email-consent.ts",
    "forecast:email:verification:send": "node --experimental-strip-types scripts/run-forecast-email-verification-send.ts",
    "forecast:email:dispatch": "node --experimental-strip-types scripts/run-forecast-email-dispatch.ts",
    "forecast:email:status": "node --experimental-strip-types scripts/run-forecast-email-status.ts",
    "auth:tenant-audit": "node --experimental-strip-types scripts/run-auth-tenant-audit.ts",
    "auth:route-audit": "node --experimental-strip-types scripts/run-auth-route-audit.ts",
    "auth:bootstrap:status": "node --experimental-strip-types scripts/run-auth-bootstrap-status.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "standardwebhooks": "1.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
